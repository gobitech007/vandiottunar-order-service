# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Its own database on the same PostgreSQL server as the user-service (create it once in pgAdmin)
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/vandi_orders

# MUST be the same JWT_SECRET as the user-service: this service checks its login tokens
JWT_SECRET=change-me

# Where the user-service runs, and its SERVICE_TOKEN (same value in both .env files)
USER_SERVICE_URL=http://localhost:8000
SERVICE_TOKEN=dev-service-token-change-me-0123456789abcdef

# Booking rules
TIMEZONE=Asia/Kolkata
DEFAULT_TRIP_HOURS=12
MAX_DAYS_AHEAD=90
# true = try to give a driver automatically as soon as a booking is made
AUTO_ASSIGN_ON_CREATE=false

# Trips: the driver may start up to this many minutes before the booked time
START_EARLY_MINUTES=120
# Wrong start/end codes allowed before the customer's code is replaced
CODE_MAX_ATTEMPTS=5
# Trip GPS points are deleted after this many days (run: python -m app.purge_locations)
LOCATION_KEEP_DAYS=90

# Booking confirmation: customer pays this (paise; 100 = ₹1) before seeing / chatting with the driver
CONFIRMATION_FEE_PAISE=100
REQUIRE_PAYMENT=true
# Customer cancellation fee (paise; 4900 = ₹49). assigned = only once a driver is assigned; always; never
CANCELLATION_FEE_PAISE=4900
CANCELLATION_FEE_APPLIES=assigned
# Driver fare for trips (paise): a full day of DAILY_HOURS costs the day rate, extra hours the hourly rate
# (never more than one more day). New customers get NEW_CUSTOMER_DISCOUNT_PCT off their first booking.
HOURLY_RATE_PAISE=15000
DAILY_RATE_PAISE=100000
DAILY_HOURS=8
NEW_CUSTOMER_DISCOUNT_PCT=10

# Public address of this service (chat links and the WhatsApp webhook use it)
PUBLIC_URL=http://localhost:8001

# WhatsApp relay between customer and driver. console = printed in this log (development);
# cloud = Meta WhatsApp Cloud API (see README "WhatsApp relay")
WHATSAPP_PROVIDER=console
WHATSAPP_BUSINESS_NUMBER=919999999999
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RELAY_TEMPLATE=booking_chat_message
WHATSAPP_TEMPLATE_LANGUAGE=en

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
